# Copy to .env only for Docker production deployment. Keep this file free of real secrets.
# Use a long URL-safe value (letters/numbers/hyphens/underscores) for Compose's database URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-database-password
JWT_SECRET=replace-with-a-long-random-application-secret
CORS_ORIGINS=https://app.example.com
HTTPS_ENABLED=true
UPLOAD_DIR=/data/uploads
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
PUBLIC_APP_URL=https://app.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=tracker@example.com
SMTP_USE_SSL=false
